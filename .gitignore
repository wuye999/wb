# Python 环境与构建产物
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# 生产凭证、商业数据、快照、抓包、浏览器登录态和运行日志
# data/ 整体保护，仅保留不含敏感信息的说明文件
/data/*
!/data/README.md
/api/
/_archive/
/logs/
/har/
/wb_browser_profiles/
/secrets/

# 临时脚本、测试副本和本机工具资料可能包含生产数据
/_scratch/*
!/_scratch/README.md
/.test-tmp/
.workbuddy/
.trae/

# 防止凭证、环境变量和抓包误放到数据目录之外
.env
.env.*
!.env.example
!.env.sample
!.env.template
credentials.json
credentials_*.json
*.har
*.har.gz
*.pem
*.key

# 根目录迁移期间的私有暂存区
/.root-migration-*/
